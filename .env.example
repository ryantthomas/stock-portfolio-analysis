# Copy to .env and adjust. All settings are optional.

# Warehouse location. dbt reads the same file.
# PORTFOLIO_DUCKDB_PATH=data/warehouse.duckdb

# Default provider preference: auto, openbb, yfinance or demo.
# PORTFOLIO_PROVIDER=auto

# Annualized risk-free rate used for Sharpe and Sortino ratios.
# PORTFOLIO_RISK_FREE_RATE=0.042

# Trading days per year, used to annualize daily statistics.
# PORTFOLIO_TRADING_DAYS=252

# Comma-separated browser origins allowed to call the API.
# PORTFOLIO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vendor OpenBB routes to. Requires the matching OpenBB credentials.
# PORTFOLIO_OPENBB_VENDOR=yfinance
